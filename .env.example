NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Production Docker serves React and the API from one HTTPS origin.
SERVE_WEB=false
WEB_DIST_PATH=apps/web/dist
# Keep 0 locally; the supplied Render Blueprint uses one trusted edge proxy.
TRUST_PROXY_HOPS=0
WEB_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:4000
# Local defaults below; for deployment collect Atlas mongodb+srv:// and Upstash rediss:// URLs.
MONGODB_URI=mongodb://localhost:27017/ai_mystery_room
REDIS_URL=redis://localhost:6379
SESSION_COOKIE_NAME=amr_guest
SESSION_SECRET=local-development-only-change-this-secret-32
AI_MODE=mock
FREE_TIER_ONLY=true
MEDIA_PROVIDER=cloudflare
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TEXT_MIN_INTERVAL_MS=15000
# Workers AI REST setup: account ID (32 hex characters) and Workers AI token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Unused while FREE_TIER_ONLY=true; the code blocks these paid media APIs.
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
# Free hosting: https://<project-ref>.storage.supabase.co/storage/v1/s3
# Copy the exact region and generated S3 key pair from Supabase Storage's S3 settings.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=ai-mystery-private
STORAGE_ACCESS_KEY=local-dev-only
STORAGE_SECRET_KEY=local-dev-only
STORAGE_FORCE_PATH_STYLE=true
# The bundled npm binaries are used when these executables are not installed.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_ACTIVE_GENERATIONS_PER_SESSION=1
MAX_NEW_CASES_PER_SESSION_PER_24H=3
GENERATION_WATCHDOG_MINUTES=20
CASE_RETENTION_DAYS=30
WORKER_CONCURRENCY=1
WORKER_DRAIN_DELAY_SECONDS=60
WORKER_STALLED_INTERVAL_MS=120000
MAX_MEDIA_BYTES=20971520
